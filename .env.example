# Local development. Copy this file to .env before running the app.
PORT=3001
DB_PATH=./data/savor.sqlite
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
JITSI_DOMAIN=meet.jit.si
SEED_DEMO=true

# Persistent cloud storage (add these directly in Render, never in GitHub).
# DATABASE_DRIVER=turso
# TURSO_DATABASE_URL=copy-the-database-URL-from-Turso
# TURSO_AUTH_TOKEN=copy-the-private-database-token-from-Turso
# When cloud storage is configured, DB_PATH is unused.

# For a public CLASSROOM DEMO deployment, use NODE_ENV=production,
# APP_ORIGIN=https://your-domain.example and SEED_DEMO=true.
# Never put real patient information in the seeded demo.
# For a deployment without demo accounts, set SEED_DEMO=false and supply:
# PROVIDER_EMAIL=clinician@your-domain.example
# PROVIDER_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# PROVIDER_NAME=Your clinician name

# First administrator, created once even with an existing patient database.
# Use an email not already registered as a patient/dietitian.
# ADMIN_EMAIL=your-private-owner-email@example.com
# ADMIN_PASSWORD=choose-a-private-password-at-least-12-characters
# ADMIN_NAME=Workspace administrator
# Remove ADMIN_PASSWORD after confirming the first admin can sign in.

# Google OAuth web client (server-only secrets).
# GOOGLE_CLIENT_ID=copy-your-web-client-id
# GOOGLE_CLIENT_SECRET=copy-your-private-client-secret

# Gmail HTTPS API sender for password recovery (never use a Gmail password).
# GMAIL_FROM=your-authorized-sender@gmail.com
# GMAIL_REFRESH_TOKEN=copy-your-private-send-only-refresh-token
# Full instructions: docs/ADMIN-GOOGLE-SETUP.md
